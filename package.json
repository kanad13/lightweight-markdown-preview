{
	"name": "lightweight-markdown-preview",
	"displayName": "Lightweight Markdown Preview",
	"description": "Lightweight, private Markdown preview for VS Code with Mermaid, D2, MathJax (LaTeX) and highlighted code. Locked-down page, no telemetry.",
	"version": "1.7.0",
	"icon": "assets/icon.png",
	"publisher": "KunalPathak",
	"author": "Kunal Pathak",
	"homepage": "https://github.com/kanad13/lightweight-markdown-preview",
	"bugs": {
		"url": "https://github.com/kanad13/lightweight-markdown-preview/issues"
	},
	"engines": {
		"vscode": "^1.105.0",
		"node": ">=22.13.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"keywords": [
		"markdown",
		"preview",
		"md",
		"mermaid",
		"mathjax",
		"diagrams",
		"equations",
		"viewer",
		"live-preview",
		"lightweight",
		"privacy",
		"render",
		"documentation",
		"chart",
		"flowchart",
		"d2",
		"d2lang",
		"kroki",
		"architecture-diagram",
		"latex",
		"azure-devops",
		"security",
		"secure",
		"sequence-diagram",
		"markdown-preview",
		"mermaid-diagram",
		"d2-diagram",
		"no-telemetry"
	],
	"qna": "marketplace",
	"galleryBanner": {
		"color": "#0D47A1",
		"theme": "dark"
	},
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "lightweightMarkdownViewer.showPreview",
				"title": "Show Lightweight Markdown Preview",
				"category": "Markdown",
				"icon": "$(eye)"
			},
			{
				"command": "lightweightMarkdownViewer.chooseD2Renderer",
				"title": "Choose D2 Renderer",
				"category": "Markdown"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "lightweightMarkdownViewer.showPreview",
					"when": "resourceLangId == markdown",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "Lightweight Markdown Preview",
			"properties": {
				"lightweightMarkdownViewer.d2.rendererUrl": {
					"type": "string",
					"default": "",
					"scope": "application",
					"markdownDescription": "Base URL of a Kroki-compatible D2 renderer, for example `http://localhost:8080` for a local Docker container or `https://kroki.io`. D2 diagrams are sent only to this URL. Leave empty to leave D2 blocks as code. Run **Markdown: Choose D2 Renderer** for a guided choice. Layout, sketch style and other D2 options go in the diagram itself, in `vars: { d2-config: { ... } }`."
				}
			}
		}
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"scripts": {
		"build": "webpack",
		"lint": "eslint .",
		"test": "npm run build && node --test \"test/*.test.js\" && npm run lint",
		"test:live": "node --test \"test/live/*.live.js\"",
		"package": "npm run build && vsce package",
		"publish": "npm run build && vsce publish"
	},
	"dependencies": {
		"marked": "^18.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.9.2",
		"@types/vscode": "1.105.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^9.39.0",
		"ovsx": "^1.3.0",
		"webpack": "^5.92.0",
		"webpack-cli": "^6.0.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanad13/lightweight-markdown-preview.git"
	},
	"license": "MIT",
	"pricing": "Free",
	"overrides": {
		"uuid": "^11.1.1"
	}
}
